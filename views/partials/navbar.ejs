<% const activePage = typeof currentPage !== 'undefined' ? currentPage : ''; %>
<nav class="nav-shell" aria-label="Primary site navigation">
  <div class="nav-inner">
    <a href="/" class="brand">MK Damp &amp; Timber LTD</a>
    <button class="nav-toggle" aria-expanded="false" aria-label="Open site menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="nav-links">
      <a href="/" class="nav-link <%= activePage === 'home' ? 'active' : '' %>">Home</a>
      <a href="/about-us/" class="nav-link <%= activePage === 'about-us' ? 'active' : '' %>">About us</a>
      <div class="nav-dropdown">
        <button type="button" class="nav-dropdown-toggle" aria-expanded="false">Services</button>
        <div class="nav-dropdown-menu">
          <a href="/damp-survey/" class="nav-dropdown-link <%= activePage === 'damp-survey' ? 'active' : '' %>">Damp survey</a>
          <a href="/damp-proofing/" class="nav-dropdown-link <%= activePage === 'damp-proofing' ? 'active' : '' %>">Damp proofing</a>
          <a href="/wet-dry-rot/" class="nav-dropdown-link <%= activePage === 'wet-dry-rot' ? 'active' : '' %>">Wet &amp; dry rot</a>
          <a href="/structural-repairs/" class="nav-dropdown-link <%= activePage === 'structural-repairs' ? 'active' : '' %>">Structural repairs</a>
          <a href="/pitched-roofing/" class="nav-dropdown-link <%= activePage === 'pitched-roofing' ? 'active' : '' %>">Pitched roofing</a>
          <a href="/flat-roofing/" class="nav-dropdown-link <%= activePage === 'flat-roofing' ? 'active' : '' %>">Flat roofing</a>
          <a href="/i-beam-fitting/" class="nav-dropdown-link <%= activePage === 'i-beam-fitting' ? 'active' : '' %>">I-beam fitting</a>
        </div>
      </div>
      <a href="/gallery/" class="nav-link <%= activePage === 'gallery' ? 'active' : '' %>">Gallery</a>
      <a href="/testimonials/" class="nav-link <%= activePage === 'testimonials' ? 'active' : '' %>">Testimonials</a>
      <a href="/faq/" class="nav-link <%= activePage === 'faq' ? 'active' : '' %>">FAQ</a>
      <a href="/contact-us/" class="nav-link <%= activePage === 'contact-us' ? 'active' : '' %>">Contact</a>
    </div>
    <a href="tel:+441923904441" class="nav-action">01923 904441</a>
  </div>
</nav>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const toggle = document.querySelector('.nav-toggle');
    const links = document.querySelector('.nav-links');
    const dropdownToggle = document.querySelector('.nav-dropdown-toggle');
    const dropdown = document.querySelector('.nav-dropdown');

    toggle.addEventListener('click', function () {
      const expanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', String(!expanded));
      links.classList.toggle('open');
    });

    const navLinks = document.querySelectorAll('.nav-link, .nav-dropdown-link');

    function closeMenu() {
      if (links.classList.contains('open')) {
        links.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      }
      if (dropdown && dropdown.classList.contains('open')) {
        dropdown.classList.remove('open');
        dropdownToggle.setAttribute('aria-expanded', 'false');
      }
    }

    dropdownToggle && dropdownToggle.addEventListener('click', function (event) {
      event.stopPropagation();
      const expanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', String(!expanded));
      dropdown.classList.toggle('open');
    });

    navLinks.forEach(function (link) {
      link.addEventListener('click', function () {
        closeMenu();
      });
    });

    document.addEventListener('click', function (event) {
      if (dropdown && !dropdown.contains(event.target) && dropdown.classList.contains('open')) {
        dropdown.classList.remove('open');
        dropdownToggle.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
