<!doctype html>
<html lang="en">
<head>
  <% var title = "Testimonials | MK Damp and Timber LTD" %>
  <%- include('../partials/seo') %>
  <meta name="description" content="Customer testimonials for MK Damp and Timber. Read real reviews from clients across damp proofing, roofing, structural repairs and timber treatments." />
  <style>
    :root{--bg:#071019;--panel:rgba(16,25,39,0.95);--accent:#f9bf5e;--accent-soft:rgba(249,191,94,0.18);--muted:#9fb0c6;--text:#eef4fb;--border:rgba(255,255,255,0.08);font-family:Inter,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}
    *{box-sizing:border-box}
    body{margin:0;background:linear-gradient(180deg,#041018,#071019);color:var(--text)}
    a{color:inherit;text-decoration:none}
    .wrap{max-width:1180px;margin:0 auto;padding:2rem}
    .hero{display:grid;gap:1rem;padding:3rem 2rem;border-radius:24px;background:linear-gradient(135deg,rgba(249,191,94,0.12),rgba(7,14,23,0.95));border:1px solid rgba(255,255,255,0.08)}
    .hero h1{margin:0;font-size:clamp(2.8rem,4vw,4.5rem)}
    .hero p{margin:.75rem 0 0;color:rgba(255,255,255,0.92);max-width:720px;font-size:1.05rem}
    .hero-actions{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.5rem}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:.95rem 1.75rem;border-radius:999px;font-weight:700;transition:transform .2s ease}
    .btn:hover{transform:translateY(-2px)}
    .btn-primary{background:#081018;color:#fff}
    .btn-secondary{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);color:#fff}
    .masonry{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:2rem}
    .card{background:var(--panel);padding:1.5rem;border-radius:22px;border:1px solid var(--border);position:relative;overflow:hidden}
    .card::before{content:'';position:absolute;top:0;right:0;bottom:0;left:0;background:linear-gradient(180deg,rgba(255,255,255,0.04),transparent);pointer-events:none}
    .stars{display:flex;gap:.25rem;margin-bottom:1rem}
    .stars span{color:var(--accent);font-size:1.05rem}
    .testimonial-text{margin:0 0 1rem;font-size:1.05rem;line-height:1.8;color:#eef4fb}
    .testimonial-meta{margin:0;font-size:.95rem;color:var(--accent)}
    .slider{position:relative;overflow:hidden;margin-top:2rem;border-radius:22px;border:1px solid var(--border);background:var(--panel)}
    .slides{display:flex;transition:transform .5s ease}
    .slide{min-width:100%;padding:2rem;display:grid;grid-template-columns:1fr;gap:1rem}
    .slider-controls{display:flex;justify-content:space-between;align-items:center;padding:1rem 1.5rem;border-top:1px solid rgba(255,255,255,0.06)}
    .slider-controls button{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:#fff;padding:.75rem 1rem;border-radius:999px;cursor:pointer}
    .slider-controls button:hover{background:rgba(255,255,255,0.1)}
    .slide-number{color:var(--muted)}
    .cta-banner{margin-top:2rem;padding:1.75rem;display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center;border-radius:22px;background:linear-gradient(135deg, rgba(255,255,255,0.06), rgba(7,14,23,0.95));border:1px solid rgba(255,255,255,0.08)}
    .cta-banner h2{margin:0;font-size:1.75rem}
    .cta-banner p{margin:.75rem 0 0;color:var(--muted);max-width:720px}
    .footer-note{margin-top:2rem;color:var(--muted);text-align:center;font-size:.95rem}
    @media(max-width:900px){.masonry{grid-template-columns:1fr}.slide{padding:1.5rem}.cta-banner{grid-template-columns:1fr}.hero{padding:2rem}}
  </style>
</head>
<body>
  <%- include('../partials/navbar', { currentPage: 'testimonials' }) %>
  <div class="wrap">
    <section class="hero">
      <div>
        <h1>What clients say about our work</h1>
        <p>Real feedback from customers who trusted MK Damp and Timber for their damp proofing, roofing, structural repairs and timber treatment projects.</p>
      </div>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/contact-us">Get in touch</a>
        <a class="btn btn-secondary" href="tel:+441923904441">Call 01923 904441</a>
      </div>
    </section>

    <section class="masonry" aria-label="Testimonials masonry layout">
      <article class="card">
        <div class="stars" aria-label="5 star rating">
          <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
        </div>
        <p class="testimonial-text">"Mark and Paul arrived promptly on the date arranged. Discussed the job, how he would do it etc., and we agreed on a couple of extras. Mark did an excellent job on restoring our chimneys, and left the site clean and tidy. Very pleasant to deal with; would have no hesitation in requesting his help again."</p>
        <p class="testimonial-meta">September 2021</p>
      </article>
    </section>

    <section class="slider" aria-label="Testimonial slider">
      <div class="slides">
        <div class="slide">
          <article class="card">
            <div class="stars"><span>★</span><span>★</span><span>★</span><span>★</span><span>★</span></div>
            <p class="testimonial-text">"Mark and Paul arrived promptly on the date arranged. Discussed the job, how he would do it etc., and we agreed on a couple of extras. Mark did an excellent job on restoring our chimneys, and left the site clean and tidy. Very pleasant to deal with; would have no hesitation in requesting his help again."</p>
            <p class="testimonial-meta">September 2021</p>
          </article>
        </div>
      </div>
      <div class="slider-controls">
        <button type="button" disabled>Prev</button>
        <span class="slide-number">1 / 1</span>
        <button type="button" disabled>Next</button>
      </div>
    </section>

    <section class="cta-banner">
      <div>
        <h2>Ready to see what quality looks like?</h2>
        <p>Contact MK Damp and Timber for a premium service, proven by our customers and delivered with craftsmanship and care.</p>
      </div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:flex-end;align-items:center">
        <a class="btn btn-secondary" href="/contact-us">Contact us</a>
        <a class="btn btn-primary" href="tel:+441923904441">Call 01923 904441</a>
      </div>
    </section>

    <p class="footer-note">MK Damp and Timber LTD • 01923 904441 • 07808 665460 • Company No. 14163466 • 31 High Street, Winslow, Buckinghamshire, MK18 3HE</p>
  </div>
</body>
</html>