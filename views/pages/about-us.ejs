<!DOCTYPE html>
<html lang="en">
<head>
	<% var title = "About Us | MK Damp and Timber LTD" %>
	<%- include('../partials/seo') %>
	<meta name="description" content="MK Damp and Timber LTD is a contractor with over 25 years of experience in damp proofing, wet rot, dry rot, roofing and general building." />
	<style>
		:root {
			--bg: #071019;
			--panel: rgba(16, 25, 39, 0.95);
			--accent: #f9bf5e;
			--accent-soft: rgba(249, 191, 94, 0.16);
			--text: #eef4fb;
			--muted: #a1b0c2;
			--border: rgba(255,255,255,0.1);
			font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
			scroll-behavior: smooth;
		}
		* { box-sizing: border-box; }
		html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--text); }
		body { line-height: 1.6; }
		img { max-width: 100%; display: block; }
		a { color: inherit; text-decoration: none; }
		.page-shell { overflow-x: hidden; }
		.hero-banner {
			min-height: 80vh;
			background: linear-gradient(180deg, rgba(7, 14, 23, 0.92), rgba(7, 14, 23, 0.88)), url('https://mkdampandtimber.co.uk/wp-content/uploads/2022/03/Damp-proofing-walls-with-membrane-400x300.jpeg') center/cover no-repeat;
			display: grid;
			place-items: center;
			padding: 3rem 1.5rem;
		}
		.hero-panel { max-width: 950px; text-align: center; }
		.eyebrow { display: inline-flex; padding: 0.75rem 1.25rem; border: 1px solid rgba(249,191,94,0.5); border-radius: 999px; color: var(--accent); text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.85rem; margin-bottom: 1.5rem; }
		h1 { font-size: clamp(3rem, 5vw, 5rem); margin: 0; line-height: 0.95; letter-spacing: -0.05em; }
		.hero-panel p { margin: 1.4rem auto 0; max-width: 760px; color: var(--muted); font-size: 1.05rem; }
		.page-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; padding: 1rem 1.5rem; background: rgba(7, 14, 23, 0.96); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 10; }
		.page-nav a { padding: 0.9rem 1.2rem; border-radius: 999px; background: rgba(255,255,255,0.05); font-size: 0.95rem; }
		.section { padding: 4rem 1.5rem; }
		.section-head { max-width: 760px; margin: 0 auto 2rem; text-align: center; }
		.section-head h2 { margin: 0.5rem 0 0; font-size: clamp(2rem, 3vw, 3rem); }
		.section-head .subtitle { color: var(--accent); letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.9rem; margin-bottom: 0.75rem; }
		.grid { display: grid; gap: 1.5rem; }
		.split { grid-template-columns: 1.1fr 0.9fr; align-items: center; }
		.panel { background: var(--panel); border: 1px solid var(--border); border-radius: 28px; padding: 2rem; }
		.panel h3 { margin: 0 0 1rem; font-size: 1.35rem; }
		.panel p { margin: 0; color: var(--muted); }
		.timeline { display: grid; gap: 1rem; }
		.timeline-step { display: grid; gap: 0.75rem; padding: 1.5rem; border-radius: 24px; border: 1px solid var(--border); background: rgba(255,255,255,0.04); }
		.timeline-step strong { display: inline-block; color: var(--accent); font-size: 1.05rem; }
		.counter-grid { grid-template-columns: repeat(4, minmax(180px, 1fr)); }
		.counter-card { padding: 2rem; border-radius: 24px; background: rgba(255,255,255,0.05); border: 1px solid var(--border); text-align: center; }
		.counter-card strong { display: block; font-size: 3rem; color: var(--accent); margin-bottom: 0.5rem; }
		.counter-card span { color: var(--muted); }
		.trust-grid { grid-template-columns: repeat(4, minmax(140px, 1fr)); align-items: center; }
		.trust-grid a { display: flex; justify-content: center; align-items: center; padding: 1.2rem; background: rgba(255,255,255,0.04); border-radius: 20px; border: 1px solid var(--border); }
		.trust-grid img { max-height: 60px; width: auto; }
		.team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.team-card { background: rgba(255,255,255,0.04); border: 1px solid var(--border); border-radius: 28px; padding: 2rem; }
		.team-card h3 { margin-top: 0; }
		.cta-panel { background: linear-gradient(135deg, rgba(249,191,94,0.18), rgba(7,14,23,0.98)); border: 1px solid var(--border); border-radius: 28px; padding: 2.5rem; display: grid; gap: 1.25rem; text-align: center; }
		.cta-panel h2 { margin: 0; font-size: clamp(2rem, 3vw, 3rem); }
		.cta-buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
		.btn { display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0 1.75rem; border-radius: 999px; font-weight: 700; border: 1px solid transparent; transition: transform 0.2s ease; }
		.btn:hover { transform: translateY(-1px); }
		.btn-primary { background: var(--accent); color: #0f1621; }
		.btn-secondary { background: rgba(255,255,255,0.08); color: var(--text); border-color: rgba(255,255,255,0.14); }
		footer { padding: 2rem 1.5rem 3.5rem; text-align: center; color: var(--muted); font-size: 0.95rem; }
		@media (max-width: 900px) { .split, .team-grid, .trust-grid, .counter-grid { grid-template-columns: 1fr; } }
		@media (max-width: 600px) { .hero-banner { padding: 2.5rem 1rem; } .page-nav { padding: 0.85rem 1rem; } }
	</style>
</head>
