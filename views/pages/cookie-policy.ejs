<!DOCTYPE html>
<html lang="en">
<head>
  <% var title = "Cookie Policy | MK Damp & Timber LTD" %>
  <%- include('../partials/seo') %>
  <meta name="description" content="Cookie policy for MK Damp & Timber LTD explaining how cookies are used on the website and how visitors can manage them." />
</head>
<body>
  <div class="page-shell">
    <%- include('../partials/navbar', { currentPage: 'cookie-policy' }) %>
    <main class="page-content">
      <section class="hero-panel section">
        <div class="section-head">
          <span class="eyebrow">Cookie transparency</span>
          <h1>Cookie Policy</h1>
          <p>Learn how MK Damp &amp; Timber LTD uses cookies to improve your experience and how to manage cookie settings.</p>
        </div>
      </section>

      <section class="section section-light">
        <div class="content-columns">
          <article>
            <div class="toc-card">
              <h4>Policy sections</h4>
              <a href="#what-are-cookies">What are cookies?</a>
              <a href="#cookie-types">Cookie types</a>
              <a href="#why-we-use-cookies">Why we use cookies</a>
              <a href="#managing-cookies">Managing cookies</a>
              <a href="#contact">Contact</a>
            </div>
          </article>
          <article>
            <section class="legal-section" id="what-are-cookies">
              <h3>What are cookies?</h3>
              <p>Cookies are small text files placed on your device to help the website remember information and improve performance.</p>
            </section>
            <section class="legal-section" id="cookie-types">
              <h3>Types of cookies we use</h3>
              <p>Essential cookies support core website functionality such as navigation and form submissions.</p>
              <p>Performance cookies collect anonymous data to improve page speed and user experience.</p>
            </section>
            <section class="legal-section" id="why-we-use-cookies">
              <h3>Why we use cookies</h3>
              <p>Cookies help our website remember your preferences, keep forms functioning correctly and allow us to deliver a reliable browsing experience.</p>
            </section>
            <section class="legal-section" id="managing-cookies">
              <h3>Managing cookies</h3>
              <p>You can manage or disable cookies through your browser settings at any time. Please note disabling cookies may affect site functionality.</p>
            </section>
            <section class="legal-section" id="contact">
              <h3>Contact</h3>
              <p>If you have a question about this policy, get in touch with MK Damp &amp; Timber LTD.</p>
              <p>Email: <a href="mailto:info@mkdampandtimber.co.uk">info@mkdampandtimber.co.uk</a></p>
              <p>Phone: <a href="tel:+441923904441">01923 904441</a></p>
            </section>
          </article>
        </div>
      </section>
    </main>
    <%- include('../partials/footer') %>
  </div>
</body>
</html>
